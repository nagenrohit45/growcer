# PostgreSQL URL. Java reads this; keep it in untracked .env.local for local use.
DATABASE_URL=
# Local frontend -> Spring Boot
API_PROXY_TARGET=http://127.0.0.1:8080
# npm run dev:backend defaults to this separate schema; deploy Java with public.
DATABASE_SCHEMA=growcer_java_local
# Java deployment settings:
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://growcer-i9j8.vercel.app
# SERVER_ADDRESS=0.0.0.0
# PORT=8080
